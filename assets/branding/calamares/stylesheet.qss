QWidget {
    font-family: "Noto Sans", sans-serif;
    color: #f1f5f9;
    background-color: #0e131f;
}

#mainApp {
    background-color: #0e131f;
    color: #f1f5f9;
}

#sidebarApp {
    background-color: #0b0f19;
    color: #f1f5f9;
}

#logoApp {
    background-color: transparent;
}

QLabel {
    color: #f1f5f9;
    background-color: transparent;
}

QLabel#textLabel, QLabel#headerLabel, QLabel#subHeaderLabel {
    color: #ffffff;
}

#requirementsWidget, #requirementsWidget QLabel, #requirementsLabel {
    color: #f1f5f9;
    background-color: transparent;
}

QPushButton {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 16px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #0078D4;
}

QPushButton:pressed {
    background-color: #0078D4;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #0f172a;
    color: #475569;
    border-color: #1e293b;
}

#nextButton {
    background-color: #0078D4;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #0078D4;
}

#nextButton:hover {
    background-color: #1084d8;
}

QComboBox {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    color: #f1f5f9;
    selection-background-color: #0078D4;
    selection-color: #ffffff;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #0078D4;
}

QTreeView, QListView, QTableView {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 4px;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: #0078D4;
    color: #ffffff;
}

QMessageBox, QDialog {
    background-color: #0e131f;
    color: #f1f5f9;
}

QToolTip {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    padding: 4px;
}

QProgressBar {
    border: 1px solid #334155;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    background-color: #1e293b;
}

QProgressBar::chunk {
    background-color: #0078D4;
    border-radius: 3px;
}
