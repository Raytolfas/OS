#!/usr/bin/env bash
set -e

WIDTH="${1:-400}"
HEIGHT="${2:-850}"

if ! command -v startplasmamobile >/dev/null 2>&1; then
    echo "[Raytolfas M1 Simulator] Error: plasma-mobile package is not installed."
    echo "Please install it by running:"
    echo "    sudo apt install -y plasma-mobile"
    exit 1
fi

export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORMTHEME=KDE
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export EGL_PLATFORM=wayland
export QT_QUICK_CONTROLS_STYLE=org.kde.breeze
export QT_QUICK_CONTROLS_MOBILE=true
export PLASMA_INTEGRATION_USE_PORTAL=1
export PLASMA_PLATFORM=phone:handset
export PLASMA_DEFAULT_SHELL=org.kde.plasma.phoneshell

echo "[Raytolfas M1 Simulator] Starting mobile session (${WIDTH}x${HEIGHT})..."
exec kwin_wayland --width "${WIDTH}" --height "${HEIGHT}" --xwayland startplasmamobile
