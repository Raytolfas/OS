#!/usr/bin/env bash
set -e

TARGET="${1:-}"
if [ -z "${TARGET}" ]; then
    echo "Usage: raytolfas-proton app.exe [args...]"
    exit 1
fi

TARGET="$(realpath "${TARGET}")"
APPDIR="$(dirname "${TARGET}")"
cd "${APPDIR}" 2>/dev/null || true

BASENAME="$(basename "${TARGET}" | tr '[:upper:]' '[:lower:]')"

IS_INSTALLER=0
if echo "${BASENAME}" | grep -qE '(setup|install|update|patch|wizard|unins)'; then
    IS_INSTALLER=1
fi

HAS_MODERN_VULKAN=1
if command -v lspci >/dev/null 2>&1; then
    if ! lspci -d 10de: -d 1002: 2>/dev/null | grep -qiE 'VGA|3D|Display'; then
        if lspci -d 8086: 2>/dev/null | grep -qiE 'VGA|3D|Display'; then
            if lspci 2>/dev/null | grep -qiE 'HD Graphics|Haswell|Ivybridge|Sandybridge|Broadwell|Ironlake'; then
                HAS_MODERN_VULKAN=0
            fi
        fi
    fi
fi

if [ "${IS_INSTALLER}" -eq 1 ] || [ "${HAS_MODERN_VULKAN}" -eq 0 ] || [ -n "${FORCE_WINE:-}" ]; then
    export WINEDEBUG="${WINEDEBUG:--all}"
    export WINEPREFIX="${WINEPREFIX:-${HOME}/.wine}"
    exec wine "${TARGET}" "${@:2}"
fi

PROTON_GE="/opt/GE-Proton"
export WINEPREFIX="${WINEPREFIX:-${HOME}/.proton-ge-prefix}"
export STEAM_COMPAT_DATA_PATH="${WINEPREFIX}"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="${HOME}/.steam/steam"
export WINEDEBUG="${WINEDEBUG:--all}"
export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-none}"
export DXVK_HUD="${DXVK_HUD:-0}"
export PROTON_FORCE_LARGE_ADDRESS_AWARE=1
export WINEESYNC=1
export WINEFSYNC=1

mkdir -p "${STEAM_COMPAT_DATA_PATH}" "${STEAM_COMPAT_CLIENT_INSTALL_PATH}"

if [ -x "${PROTON_GE}/proton" ]; then
    exec "${PROTON_GE}/proton" run "${TARGET}" "${@:2}"
elif [ -f "${PROTON_GE}/files/bin/wine" ]; then
    export PATH="${PROTON_GE}/files/bin:${PATH}"
    export LD_LIBRARY_PATH="${PROTON_GE}/files/lib/x86_64-linux-gnu:${PROTON_GE}/files/lib/i386-linux-gnu:${PROTON_GE}/files/lib:${LD_LIBRARY_PATH:-}"
    export WINESERVER="${PROTON_GE}/files/bin/wineserver"
    exec "${PROTON_GE}/files/bin/wine" "${TARGET}" "${@:2}"
else
    exec wine "${TARGET}" "${@:2}"
fi
