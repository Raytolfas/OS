#!/usr/bin/env bash
set -e

sudo sysctl -w net.ipv4.ip_forward=1 2>/dev/null || sysctl -w net.ipv4.ip_forward=1 2>/dev/null || true

sudo iptables -C FORWARD -i waydroid0 -j ACCEPT 2>/dev/null || sudo iptables -I FORWARD -i waydroid0 -j ACCEPT 2>/dev/null || true
sudo iptables -C FORWARD -o waydroid0 -j ACCEPT 2>/dev/null || sudo iptables -I FORWARD -o waydroid0 -j ACCEPT 2>/dev/null || true
sudo iptables -t nat -C POSTROUTING -s 192.168.240.0/24 ! -d 192.168.240.0/24 -j MASQUERADE 2>/dev/null || sudo iptables -t nat -A POSTROUTING -s 192.168.240.0/24 ! -d 192.168.240.0/24 -j MASQUERADE 2>/dev/null || true

if waydroid status 2>/dev/null | grep -q "RUNNING"; then
    waydroid prop set persist.waydroid.dns 8.8.8.8 2>/dev/null || true
    waydroid prop set persist.waydroid.dns2 1.1.1.1 2>/dev/null || true
    waydroid shell setprop net.dns1 8.8.8.8 2>/dev/null || true
    waydroid shell setprop net.dns2 1.1.1.1 2>/dev/null || true
fi
