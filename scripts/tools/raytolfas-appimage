#!/usr/bin/env bash
set -euo pipefail

APPIMAGE="${1:-}"
ACTION="${2:-run}"

if [ -z "${APPIMAGE}" ] || [ ! -f "${APPIMAGE}" ]; then
    echo "File not found: ${APPIMAGE}"
    exit 1
fi

APPIMAGE="$(realpath "${APPIMAGE}")"
chmod +x "${APPIMAGE}"

APP_NAME="$(basename "${APPIMAGE}" .AppImage)"
DESK_DIR="${HOME}/.local/share/applications"
ICON_DIR="${HOME}/.local/share/icons/hicolor/256x256/apps"

mkdir -p "${DESK_DIR}" "${ICON_DIR}"

integrate_appimage() {
    local tmp_dir
    tmp_dir="$(mktemp -d -p /tmp appimage-XXXXXX)"
    (
        cd "${tmp_dir}"
        "${APPIMAGE}" --appimage-extract "*.desktop" >/dev/null 2>&1 || true
        "${APPIMAGE}" --appimage-extract "*.png" >/dev/null 2>&1 || true
        "${APPIMAGE}" --appimage-extract "*.svg" >/dev/null 2>&1 || true
    )

    local extracted_desktop
    extracted_desktop="$(find "${tmp_dir}/squashfs-root" -name "*.desktop" 2>/dev/null | head -n 1 || true)"
    local extracted_icon
    extracted_icon="$(find "${tmp_dir}/squashfs-root" \( -name "*.png" -o -name "*.svg" \) 2>/dev/null | head -n 1 || true)"

    local icon_name="application-x-executable"
    if [ -n "${extracted_icon}" ] && [ -f "${extracted_icon}" ]; then
        local ext="${extracted_icon##*.}"
        cp -f "${extracted_icon}" "${ICON_DIR}/${APP_NAME}.${ext}"
        icon_name="${APP_NAME}"
    fi

    local target_desktop="${DESK_DIR}/${APP_NAME}.desktop"
    if [ -n "${extracted_desktop}" ] && [ -f "${extracted_desktop}" ]; then
        cp -f "${extracted_desktop}" "${target_desktop}"
        sed -i "s|^Exec=.*|Exec=\"${APPIMAGE}\" %U|g" "${target_desktop}"
        if [ "${icon_name}" != "application-x-executable" ]; then
            sed -i "s|^Icon=.*|Icon=${icon_name}|g" "${target_desktop}"
        fi
    else
        cat << EOF > "${target_desktop}"
[Desktop Entry]
Type=Application
Name=${APP_NAME}
Exec="${APPIMAGE}" %U
Icon=${icon_name}
Categories=Utility;
Terminal=false
EOF
    fi

    chmod 0644 "${target_desktop}"
    rm -rf "${tmp_dir}"

    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "${DESK_DIR}" 2>/dev/null || true
    fi

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i "${icon_name}" "AppImage Integrated" "${APP_NAME} added to application menu" 2>/dev/null || true
    fi
}

integrate_appimage

if [ "${ACTION}" = "run" ]; then
    exec "${APPIMAGE}" "${@:3}"
fi
