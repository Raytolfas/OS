<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<language name="RayQuiro" version="1" kateversion="5.0" section="Sources" extensions="*.rq;*.rqb;*.rayquiro" mimetype="text/x-rayquiro;application/x-rayquiro-bytecode">
  <highlighting>
    <list name="keywords">
      <item>fn</item>
      <item>let</item>
      <item>mut</item>
      <item>const</item>
      <item>if</item>
      <item>else</item>
      <item>loop</item>
      <item>while</item>
      <item>for</item>
      <item>in</item>
      <item>match</item>
      <item>return</item>
      <item>struct</item>
      <item>enum</item>
      <item>impl</item>
      <item>import</item>
      <item>export</item>
      <item>pub</item>
      <item>async</item>
      <item>await</item>
      <item>rq</item>
      <item>io</item>
    </list>
    <list name="types">
      <item>i8</item>
      <item>i16</item>
      <item>i32</item>
      <item>i64</item>
      <item>u8</item>
      <item>u16</item>
      <item>u32</item>
      <item>u64</item>
      <item>f32</item>
      <item>f64</item>
      <item>bool</item>
      <item>str</item>
      <item>string</item>
      <item>char</item>
      <item>byte</item>
      <item>void</item>
    </list>
    <list name="constants">
      <item>true</item>
      <item>false</item>
      <item>null</item>
    </list>
    <contexts>
      <context attribute="Normal Text" lineEndContext="#stay" name="Normal">
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <keyword attribute="Constant" context="#stay" String="constants"/>
        <Detect2Chars attribute="Comment" context="CommentLine" char="/" char1="/"/>
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <DetectChar attribute="Char" context="Char" char="'"/>
        <Float attribute="Float" context="#stay"/>
        <Int attribute="Decimal" context="#stay"/>
      </context>
      <context attribute="Comment" lineEndContext="#pop" name="CommentLine"/>
      <context attribute="Comment" lineEndContext="#stay" name="CommentBlock">
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/" endRegion="CommentBlockRegion"/>
      </context>
      <context attribute="String" lineEndContext="#pop" name="String">
        <LineContinue attribute="String" context="#stay"/>
        <Detect2Chars attribute="Special Char" context="#stay" char="\" char1="&quot;"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
      <context attribute="Char" lineEndContext="#pop" name="Char">
        <Detect2Chars attribute="Special Char" context="#stay" char="\" char1="'"/>
        <DetectChar attribute="Char" context="#pop" char="'"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword" color="#38bdf8" bold="1"/>
      <itemData name="Data Type" defStyleNum="dsDataType" color="#a78bfa" bold="0"/>
      <itemData name="Constant" defStyleNum="dsConstant" color="#f59e0b" bold="0"/>
      <itemData name="Comment" defStyleNum="dsComment" color="#64748b" italic="1"/>
      <itemData name="String" defStyleNum="dsString" color="#10b981"/>
      <itemData name="Char" defStyleNum="dsChar" color="#10b981"/>
      <itemData name="Special Char" defStyleNum="dsSpecialChar" color="#06b6d4"/>
      <itemData name="Decimal" defStyleNum="dsDecVal" color="#fb923c"/>
      <itemData name="Float" defStyleNum="dsFloat" color="#fb923c"/>
    </itemDatas>
  </highlighting>
</language>
